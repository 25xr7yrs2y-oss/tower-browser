<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TowerBrowser</AssemblyName>
    <RootNamespace>PrivacyBrowser.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Version>1.0.10</Version>
    <VersionPrefix>1.0.10</VersionPrefix>
    <PackageVersion>1.0.10</PackageVersion>
    <AssemblyVersion>1.0.10.0</AssemblyVersion>
    <FileVersion>1.0.10.0</FileVersion>
    <InformationalVersion>1.0.10</InformationalVersion>
    <Product>Tower Browser</Product>
    <AssemblyTitle>Tower Browser</AssemblyTitle>
    <Description>Native browser-scoped privacy controller for Windows.</Description>
    <Authors>Tower Browser Contributors</Authors>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\Icons\app-icon-256.png" />
  </ItemGroup>
</Project>
