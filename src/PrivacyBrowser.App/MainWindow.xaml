<Window x:Class="PrivacyBrowser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tower Browser" Icon="Assets/Icons/app-icon-256.png"
        Height="780" Width="1180" MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBackground}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="28,18">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Tower Browser" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Private browsing through a browser-scoped Mysterium provider"
                               Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                </StackPanel>
                <Button x:Name="ControlsButton" Content="Controls" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="ControlsButton_Click" AutomationProperties.Name="Open connection controls" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218" />
                <ColumnDefinition Width="*" MinWidth="500" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FAFCFB" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0"
                    Padding="16,22" KeyboardNavigation.TabNavigation="Local">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="PAGES" Style="{StaticResource Eyebrow}" Margin="12,0,0,10" />
                    <StackPanel>
                        <Button x:Name="HomeNavigationButton" Content="_Home" Tag="Home" Click="NavigateButton_Click"
                                Style="{StaticResource SelectedNavigationButton}" AutomationProperties.Name="Home page" />
                        <Button x:Name="IdentityNavigationButton" Content="_Identity" Tag="Identity" Click="NavigateButton_Click"
                                Style="{StaticResource NavigationButton}" AutomationProperties.Name="Identity page" />
                        <Button x:Name="WalletNavigationButton" Content="_Wallet" Tag="Wallet" Click="NavigateButton_Click"
                                Style="{StaticResource NavigationButton}" AutomationProperties.Name="Wallet page" />
                        <Button x:Name="ConnectionNavigationButton" Content="_Connection" Tag="Connection" Click="NavigateButton_Click"
                                Style="{StaticResource NavigationButton}" AutomationProperties.Name="Connection page" />
                        <Button x:Name="BrowserNavigationButton" Content="_Browser &amp; diagnostics" Tag="BrowserAndDiagnostics"
                                Click="NavigateButton_Click" Style="{StaticResource NavigationButton}"
                                AutomationProperties.Name="Browser and diagnostics page" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="28,16">
                    <StackPanel>
                        <TextBlock x:Name="CurrentPageTitle" Text="Home" FontSize="22" FontWeight="SemiBold"
                                   Focusable="True" AutomationProperties.Name="Current page" />
                        <TextBlock x:Name="CurrentPageDescription" Text="A concise summary of your privacy session."
                                   Style="{StaticResource SecondaryText}" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="OperationStatusBorder" Grid.Row="1" Background="{StaticResource PrimarySoft}" CornerRadius="8"
                        Padding="12" Margin="28,16,28,0" Visibility="Collapsed"
                        AutomationProperties.Name="Current page operation feedback">
                    <StackPanel>
                        <TextBlock x:Name="OperationStatusText" Foreground="{StaticResource Primary}" TextWrapping="Wrap"
                                   AutomationProperties.Name="Current page operation status" AutomationProperties.LiveSetting="Polite" />
                        <ProgressBar x:Name="OperationProgressBar" Height="3" IsIndeterminate="True" Margin="0,9,0,0" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" Padding="28,20"
                                  AutomationProperties.Name="Home page content">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Padding="26">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ConnectionStatusDot" Width="11" Height="11" Fill="#A2ACA8"
                                                 Margin="0,4,9,0" VerticalAlignment="Top" />
                                        <TextBlock x:Name="ConnectionStatusText" Text="Starting backend…" FontSize="30" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <TextBlock x:Name="ConnectionDetailText" Text="The native controller is preparing Myst."
                                               Style="{StaticResource SecondaryText}" FontSize="14" Margin="20,7,0,0" />
                                    <TextBlock x:Name="ConnectedProviderText" Text="No provider selected"
                                               Foreground="{StaticResource Primary}" FontWeight="SemiBold" Margin="20,10,0,0" />
                                </StackPanel>
                            </Border>

                            <UniformGrid Columns="4" Margin="0,16,0,0">
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="BACKEND" Style="{StaticResource Eyebrow}" />
                                        <TextBlock x:Name="MainBackendText" Text="Starting" FontWeight="SemiBold" FontSize="16" Margin="0,7,0,0" />
                                        <TextBlock x:Name="MainBackendDetailText" Text="Checking service" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="IDENTITY" Style="{StaticResource Eyebrow}" />
                                        <TextBlock x:Name="MainIdentityText" Text="Checking" FontWeight="SemiBold" FontSize="16" Margin="0,7,0,0" />
                                        <TextBlock x:Name="MainIdentityDetailText" Text="No address yet" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="BALANCE" Style="{StaticResource Eyebrow}" />
                                        <TextBlock x:Name="MainBalanceText" Text="— MYST" FontWeight="SemiBold" FontSize="16" Margin="0,7,0,0" />
                                        <TextBlock x:Name="MainPaymentText" Text="Identity required" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="16">
                                    <StackPanel>
                                        <TextBlock Text="PROVIDER" Style="{StaticResource Eyebrow}" />
                                        <TextBlock x:Name="MainProviderText" Text="None" FontWeight="SemiBold" FontSize="16" Margin="0,7,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="MainProviderDetailText" Text="Choose on Connection" Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Next steps" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="Set up an identity and wallet, choose a provider, then verify and launch the isolated browser."
                                                   Style="{StaticResource SecondaryText}" Margin="0,5,20,0" />
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="Identity" Tag="Identity" Click="NavigateButton_Click" Style="{StaticResource SecondaryButton}" />
                                        <Button Content="Connection" Tag="Connection" Click="NavigateButton_Click" />
                                    </WrapPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Privacy boundary" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Margin="0,7,0,0" Style="{StaticResource SecondaryText}"
                                               Text="Only this isolated Mullvad Browser profile uses the provider proxy. The native window owns the backend directly; other Windows applications keep their normal network path." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="IdentityPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,20"
                                  AutomationProperties.Name="Identity page content">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Consumer terms" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Required before creating or using an identity." Style="{StaticResource SecondaryText}" Margin="0,4,0,10" />
                                    <CheckBox x:Name="AcceptTermsCheckBox" Click="AcceptTermsCheckBox_Click"
                                              Content="I accept the current consumer terms" />
                                    <TextBlock x:Name="TermsVersionText" Style="{StaticResource SecondaryText}" FontSize="12" Margin="22,5,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Mysterium identity" Style="{StaticResource SectionTitle}" />
                                        <Border x:Name="IdentityStatusBadge" Background="#EDF1F0" CornerRadius="10" Padding="8,3"
                                                HorizontalAlignment="Right">
                                            <TextBlock x:Name="IdentityStatusBadgeText" Text="Checking" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="Selected identity" FontWeight="SemiBold" Margin="0,14,0,5" />
                                    <ComboBox x:Name="IdentityComboBox" DisplayMemberPath="DisplayName"
                                              SelectionChanged="IdentityComboBox_SelectionChanged"
                                              AutomationProperties.Name="Selected Mysterium identity" />
                                    <TextBlock x:Name="IdentityAddressText" Text="Checking identity…" TextWrapping="Wrap"
                                               FontFamily="Consolas" FontSize="12" Margin="0,8,0,0" />
                                    <TextBlock x:Name="IdentityHelpText" Style="{StaticResource SecondaryText}" Margin="0,6,0,9" />
                                    <WrapPanel>
                                        <Button x:Name="CreateIdentityButton" Content="Create identity" Click="CreateIdentityButton_Click" />
                                        <Button x:Name="ImportIdentityButton" Content="Import identity" Click="ImportIdentityButton_Click"
                                                Style="{StaticResource SecondaryButton}" />
                                        <Button x:Name="UnlockIdentityButton" Content="Unlock" Click="UnlockIdentityButton_Click"
                                                Style="{StaticResource SecondaryButton}" IsEnabled="False" />
                                        <Button x:Name="RegisterIdentityButton" Content="Register" Click="RegisterIdentityButton_Click"
                                                Style="{StaticResource SecondaryButton}" IsEnabled="False" />
                                        <Button x:Name="RefreshIdentityButton" Content="Refresh status" Click="RefreshIdentityButton_Click"
                                                Style="{StaticResource NeutralButton}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="WalletPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,20"
                                  AutomationProperties.Name="Wallet page content">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}" Padding="24">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Wallet balance" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Text="MYST" Foreground="{StaticResource Primary}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock x:Name="WalletBalanceText" Text="—" FontSize="32" FontWeight="SemiBold" Margin="0,14,0,0" />
                                    <TextBlock x:Name="WalletPaymentStatusText" Text="Create an identity to view payment status."
                                               Style="{StaticResource SecondaryText}" Margin="0,4,0,12" />
                                    <WrapPanel>
                                        <Button x:Name="RefreshBalanceButton" Content="Refresh balance" Click="RefreshBalanceButton_Click"
                                                Style="{StaticResource SecondaryButton}" IsEnabled="False" />
                                        <Button x:Name="TopUpButton" Content="Top up" Click="TopUpButton_Click" IsEnabled="False" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="Payment safety" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="Payment orders open only after their gateway-bound HTTPS target passes the app's validation checks."
                                               Style="{StaticResource SecondaryText}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="ConnectionPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,20"
                                  AutomationProperties.Name="Connection page content">
                        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}" Padding="22">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="WireGuard provider" Style="{StaticResource SectionTitle}" />
                                        <TextBlock x:Name="ProviderCountText" Text="Not loaded" Style="{StaticResource SecondaryText}"
                                                   FontSize="12" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="Search available providers" FontWeight="SemiBold" Margin="0,14,0,6" />
                                    <TextBox x:Name="ProviderSearchTextBox" TextChanged="ProviderSearchTextBox_TextChanged"
                                             AutomationProperties.Name="Search providers" Margin="0,0,0,8"
                                             ToolTip="Search by country, city, provider ID, or ISP" />
                                    <ComboBox x:Name="ProviderComboBox" DisplayMemberPath="DisplayName"
                                              SelectionChanged="ProviderComboBox_SelectionChanged"
                                              AutomationProperties.Name="Selected WireGuard provider" />
                                    <TextBlock x:Name="ProviderDetailText" Text="Refresh to discover providers."
                                               Style="{StaticResource SecondaryText}" FontSize="12" Margin="0,7,0,8" />
                                    <TextBlock x:Name="ConnectionPrerequisiteText" Style="{StaticResource SecondaryText}"
                                               FontSize="12" Margin="0,0,0,7" />
                                    <WrapPanel>
                                        <Button x:Name="RefreshProvidersButton" Content="Refresh providers" Click="RefreshProvidersButton_Click"
                                                Style="{StaticResource SecondaryButton}" />
                                        <Button x:Name="ConnectButton" Content="Connect" Click="ConnectButton_Click" IsEnabled="False" />
                                        <Button x:Name="DisconnectButton" Content="Disconnect" Click="DisconnectButton_Click"
                                                Style="{StaticResource DangerButton}" IsEnabled="False" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer x:Name="BrowserAndDiagnosticsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,20"
                                  AutomationProperties.Name="Browser and diagnostics page content">
                        <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                            <Border Style="{StaticResource Card}" Padding="22">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="BrowserReadinessIcon" Width="36" Height="36" CornerRadius="18"
                                            Background="#EDF1F0" VerticalAlignment="Top">
                                        <TextBlock x:Name="BrowserReadinessGlyph" Text="…" Foreground="#68736F" FontSize="18" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,20,0">
                                        <TextBlock Text="Browser readiness" Style="{StaticResource SectionTitle}" />
                                        <TextBlock x:Name="BrowserReadinessText" Text="Connect to a provider before launching the browser."
                                                   Style="{StaticResource SecondaryText}" Margin="0,5,0,0" />
                                    </StackPanel>
                                    <Button x:Name="LaunchBrowserButton" Grid.Column="2" Content="Launch browser" Click="LaunchBrowserButton_Click"
                                            IsEnabled="False" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="20">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Backend service" Style="{StaticResource SectionTitle}" />
                                        <TextBlock x:Name="BackendLifecycleText" Text="Starting" Style="{StaticResource SecondaryText}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="Tower Browser supervises the Myst process it starts. Restart is available after a crash or failed startup."
                                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,6,0,10" />
                                    <Button x:Name="RestartBackendButton" Content="Restart backend" Click="RestartBackendButton_Click"
                                            Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,16,0,16" Padding="20">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Activity" Style="{StaticResource SectionTitle}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Copy" Click="CopyActivityButton_Click" AutomationProperties.Name="Copy activity"
                                                    Style="{StaticResource NeutralButton}" Padding="10,4" MinHeight="28" />
                                            <Button Content="Clear" Click="ClearActivityButton_Click" AutomationProperties.Name="Clear activity"
                                                    Style="{StaticResource NeutralButton}" Padding="10,4" MinHeight="28" Margin="0" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBox x:Name="ActivityText" Height="190" IsReadOnly="True" TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto" Background="#F7F9F8" Padding="9"
                                             FontFamily="Consolas" FontSize="12" Margin="0,10,0,0"
                                             AutomationProperties.Name="Backend activity log" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="28,10">
            <Grid>
                <TextBlock x:Name="FooterStatusText" Text="Initializing native controller…" Style="{StaticResource SecondaryText}" />
                <TextBlock x:Name="LastUpdatedText" HorizontalAlignment="Right" Style="{StaticResource SecondaryText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
